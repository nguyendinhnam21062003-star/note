# Server-only: never prefix these values with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/notes?sslmode=verify-full
# Run pnpm configure to generate a salted hash without storing a plaintext password.
NOTES_PASSWORD_HASH=scrypt:32_HEX_SALT:128_HEX_DERIVED_KEY
# Exact public origin, no trailing slash. Set when deploying behind a reverse proxy.
APP_ORIGIN=https://notes.example.com
